generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountDeletionRequest {
  id           String    @id
  userId       String    @unique
  reason       String?
  status       String    @default("pending")
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([scheduledFor])
  @@index([status])
}

model Category {
  id          String        @id
  name        String        @unique
  slug        String        @unique
  description String?
  icon        String?
  order       Int           @default(0)
  Course      Course[]
  Publication Publication[]
}

model Certificate {
  id            String         @id
  userId        String
  courseId      String
  certificateId String         @unique
  score         Float
  issuedAt      DateTime       @default(now())
  ceuExpiryDate DateTime
  ceuHours      Float
  contentType   CPDContentType
  Course        Course         @relation(fields: [courseId], references: [id])
  User          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, ceuExpiryDate])
}

model Course {
  id              String         @id
  title           String
  slug            String         @unique
  description     String
  thumbnail       String?
  categoryId      String
  cpdHours        Float
  difficulty      String
  sourceArticle   String?
  published       Boolean        @default(false)
  price           Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  creatorId       String?
  isDraft         Boolean        @default(true)
  publishedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  submittedAt     DateTime?
  totalViews      Int            @default(0)
  averageRating   Float?         @default(0)
  ratingCount     Int            @default(0)
  activeFrom      DateTime?
  activeTo        DateTime?
  isFeatured      Boolean        @default(false)
  rotationMonth   Int?
  cpdContentType  CPDContentType @default(CLINICAL)
  Certificate     Certificate[]
  Category        Category       @relation(fields: [categoryId], references: [id])
  User            User?          @relation(fields: [creatorId], references: [id])
  Enrollment      Enrollment[]
  Review          Review[]
  Section         Section[]
  View            View[]

  @@index([creatorId])
  @@index([isFeatured, activeFrom, activeTo])
  @@index([rotationMonth])
}

model CreatorApplication {
  id              String        @id
  userId          String
  motivation      String
  expertise       String
  experience      String
  sampleContent   String?
  cvUrl           String
  status          CreatorStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  User            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model CreatorEarning {
  id            String    @id
  revenueId     String
  creatorId     String
  views         Int
  viewShare     Float
  grossEarnings Float
  platformFee   Float
  netEarnings   Float
  paid          Boolean   @default(false)
  paidAt        DateTime?
  payoutId      String?
  createdAt     DateTime  @default(now())
  User          User      @relation(fields: [creatorId], references: [id])
  Payout        Payout?   @relation(fields: [payoutId], references: [id])
  Revenue       Revenue   @relation(fields: [revenueId], references: [id], onDelete: Cascade)

  @@unique([revenueId, creatorId])
  @@index([creatorId, paid])
}

model DMCAReport {
  id                 String     @id
  reporterName       String
  reporterEmail      String
  reporterAddress    String
  copyrightOwner     String
  workDescription    String
  infringingUrl      String
  goodFaithStatement Boolean
  accuracyStatement  Boolean
  signature          String
  contentId          String?
  contentType        String?
  status             DMCAStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewedBy         String?
  resolution         String?
  createdAt          DateTime   @default(now())

  @@index([createdAt])
  @@index([status])
}

model DataExportRequest {
  id          String    @id
  userId      String
  status      String    @default("pending")
  downloadUrl String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([userId])
}

model Enrollment {
  id          String    @id
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  Course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model FileUpload {
  id         String   @id
  userId     String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  @@index([userId])
}

model Follow {
  id                            String   @id
  followerId                    String
  followingId                   String
  createdAt                     DateTime @default(now())
  User_Follow_followerIdToUser  User     @relation("Follow_followerIdToUser", fields: [followerId], references: [id], onDelete: Cascade)
  User_Follow_followingIdToUser User     @relation("Follow_followingIdToUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model MonthlyBundle {
  id            String   @id
  name          String
  description   String
  month         Int
  year          Int
  totalCpdHours Float
  courseIds     Json
  thumbnail     String?
  activeFrom    DateTime
  activeTo      DateTime
  isCurrent     Boolean  @default(false)
  price         Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@unique([year, month])
  @@index([isCurrent, activeFrom, activeTo])
}

model Notification {
  id        String   @id
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  data      Json?
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, read])
}

model Payout {
  id               String           @id
  creatorId        String
  amount           Float
  currency         String           @default("zar")
  stripePayoutId   String?          @unique
  stripeTransferId String?          @unique
  status           PayoutStatus     @default(PENDING)
  failureReason    String?
  initiatedAt      DateTime         @default(now())
  completedAt      DateTime?
  failedAt         DateTime?
  CreatorEarning   CreatorEarning[]
  User             User             @relation(fields: [creatorId], references: [id])

  @@index([creatorId, status])
  @@index([status, initiatedAt])
}

model Progress {
  id          String    @id
  userId      String
  sectionId   String
  completed   Boolean   @default(false)
  timeSpent   Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  Section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
}

model Publication {
  id              String    @id
  title           String
  description     String
  creatorId       String
  fileUrl         String
  thumbnail       String?
  doi             String?
  journal         String?
  publishedDate   DateTime?
  keywords        String[]
  categoryId      String
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  rejectedAt      DateTime?
  rejectionReason String?
  submittedAt     DateTime?
  totalViews      Int       @default(0)
  Category        Category  @relation(fields: [categoryId], references: [id])
  User            User      @relation(fields: [creatorId], references: [id])
  View            View[]

  @@index([creatorId])
}

model Question {
  id            String        @id
  sectionId     String?
  courseId      String
  questionText  String
  context       String?
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  order         Int
  Section       Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  QuizAttempt   QuizAttempt[]
}

model QuizAttempt {
  id            String   @id
  userId        String
  questionId    String
  answer        String
  isCorrect     Boolean
  attemptNumber Int      @default(1)
  timeSpent     Int?
  createdAt     DateTime @default(now())
  Question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
}

model Revenue {
  id             String           @id
  month          Int
  year           Int
  totalRevenue   Float
  totalViews     Int
  revenuePerView Float
  calculated     Boolean          @default(false)
  calculatedAt   DateTime?
  createdAt      DateTime         @default(now())
  CreatorEarning CreatorEarning[]

  @@unique([year, month])
  @@index([calculated])
}

model Review {
  id             String           @id
  userId         String
  courseId       String
  rating         Int
  title          String?
  comment        String?
  reported       Boolean          @default(false)
  hidden         Boolean          @default(false)
  helpful        Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ReviewResponse ReviewResponse[]

  @@unique([userId, courseId])
  @@index([courseId, rating])
  @@index([createdAt])
}

model ReviewResponse {
  id        String   @id
  reviewId  String
  creatorId String
  comment   String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [creatorId], references: [id])
  Review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Section {
  id             String     @id
  courseId       String
  title          String
  content        String
  order          Int
  minTimeSeconds Int        @default(300)
  contentType    String     @default("text")
  duration       Int?
  pdfUrl         String?
  videoUrl       String?
  Progress       Progress[]
  Question       Question[]
  Course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  billingInterval      BillingInterval
  amount               Float
  currency             String             @default("zar")
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  startDate            DateTime           @default(now())
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  autoRenew            Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime
  SubscriptionPlan     SubscriptionPlan   @relation(fields: [planId], references: [id])
  User                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@index([stripeSubscriptionId])
  @@index([userId, status])
}

model SubscriptionPlan {
  id                String           @id
  name              String           @unique
  tier              SubscriptionTier
  description       String
  features          Json
  monthlyPrice      Float
  yearlyPrice       Float
  cpdPointsPerYear  Float
  courseAccessLevel String           @default("all")
  active            Boolean          @default(true)
  displayOrder      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  Subscription      Subscription[]
}

model User {
  id                              String               @id
  email                           String               @unique
  name                            String?
  password                        String?
  role                            Role                 @default(USER)
  specialty                       String?
  institution                     String?
  country                         String?
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime
  avatar                          String?
  bio                             String?
  creatorStatus                   CreatorStatus        @default(NONE)
  cvUrl                           String?
  isCreator                       Boolean              @default(false)
  socialLinks                     Json?
  stripeAccountId                 String?              @unique
  stripeChargesEnabled            Boolean              @default(false)
  stripeDetailsSubmitted          Boolean              @default(false)
  stripeOnboarded                 Boolean              @default(false)
  stripePayoutsEnabled            Boolean              @default(false)
  emailPreferences                Json?                @default("{\"payouts\": true, \"reviews\": true, \"earnings\": true, \"newFollowers\": true, \"weeklySummary\": true, \"courseApproved\": true, \"courseRejected\": true}")
  emailVerified                   DateTime?
  resetToken                      String?              @unique
  resetTokenExpiry                DateTime?
  stripeCustomerId                String?              @unique
  verificationToken               String?              @unique
  verificationTokenExpiry         DateTime?
  cpdExemptUntil                  DateTime?
  hpcsaNumber                     String?
  isInCommunityService            Boolean              @default(false)
  isRegistrar                     Boolean              @default(false)
  profession                      String?
  Certificate                     Certificate[]
  Course                          Course[]
  CreatorApplication              CreatorApplication[]
  CreatorEarning                  CreatorEarning[]
  Enrollment                      Enrollment[]
  Follow_Follow_followerIdToUser  Follow[]             @relation("Follow_followerIdToUser")
  Follow_Follow_followingIdToUser Follow[]             @relation("Follow_followingIdToUser")
  Notification                    Notification[]
  Payout                          Payout[]
  Progress                        Progress[]
  Publication                     Publication[]
  QuizAttempt                     QuizAttempt[]
  Review                          Review[]
  ReviewResponse                  ReviewResponse[]
  Subscription                    Subscription[]
  View_View_creatorIdToUser       View[]               @relation("View_creatorIdToUser")
  View_View_userIdToUser          View[]               @relation("View_userIdToUser")
}

model UserConsent {
  id                String    @id
  userId            String    @unique
  termsAccepted     Boolean   @default(false)
  termsAcceptedAt   DateTime?
  privacyAccepted   Boolean   @default(false)
  privacyAcceptedAt DateTime?
  ageVerified       Boolean   @default(false)
  ageVerifiedAt     DateTime?
  marketingEmails   Boolean   @default(false)
  marketingEmailsAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
}

model View {
  id                        String       @id
  userId                    String?
  courseId                  String?
  publicationId             String?
  creatorId                 String
  duration                  Int          @default(0)
  completed                 Boolean      @default(false)
  ipAddress                 String?
  userAgent                 String?
  referrer                  String?
  createdAt                 DateTime     @default(now())
  Course                    Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User_View_creatorIdToUser User         @relation("View_creatorIdToUser", fields: [creatorId], references: [id])
  Publication               Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  User_View_userIdToUser    User?        @relation("View_userIdToUser", fields: [userId], references: [id])

  @@index([courseId, createdAt])
  @@index([creatorId, createdAt])
  @@index([userId, createdAt])
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum CPDContentType {
  CLINICAL
  ETHICS_HUMAN_RIGHTS_LAW
}

enum CreatorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DMCAStatus {
  PENDING
  UNDER_REVIEW
  CONTENT_REMOVED
  DISMISSED
  COUNTER_NOTICE_RECEIVED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum Role {
  USER
  ADMIN
  INSTRUCTOR
  CREATOR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
}

enum SubscriptionTier {
  BASIC
  PROFESSIONAL
  PREMIUM
}
